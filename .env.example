# Call-Astro Task Tracker Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Application Server Port & URL
PORT=5000
APP_URL=http://localhost:5173

# JWT Authentication Secret (Generate a strong random string in production)
JWT_SECRET=super_secret_task_tracker_jwt_production_key_2026

# SMTP Email Configuration
SMTP_HOST=mail.callastro.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@callastro.com
SMTP_PASS=your_email_password
MAIL_FROM="Call Astro Tasks <your_email@callastro.com>"

# Default Initial Administrator Login Credentials (Used during first-time database setup or seed)
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_PASSWORD=SetYourAdminPasswordHere!
