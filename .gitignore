# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build outputs
dist/
dist-ssr/
build/
*.local

# Environment variables & secrets (CRITICAL: Never commit secrets to git)
.env
.env.*
!.env.example
*.env

# SQLite Database & Storage (CRITICAL: Contains employee data & credentials)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
server/db/*.db
server/db/*.sqlite*

# User Uploaded Attachments & Media (Keep folder structure only via .gitkeep)
uploads/*
!uploads/.gitkeep
uploads/avatars/*
!uploads/avatars/.gitkeep

# Temporary scratch & debug scripts
scratch*
scratch_*.*
scratch/
temp/
*.tmp
test_run*

# Caches & Test Coverage
.cache/
.parcel-cache/
.vite/
.eslintcache
coverage/
.turbo/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & IDE directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
